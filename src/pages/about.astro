---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import About from '../components/About.tsx';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/bulma.min.css';
import '../styles/theme.css';

const base = '/Germain/';
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead title={`À propos – ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="apropos-intro">
        <div class="container">
          <h1 class="apropos-titre righteous"><span aria-hidden="true">//</span> À propos</h1>
          <p class="apropos-chapeau">
            Germain est un projet éducatif et open source pour explorer les mathématiques. Voici d'où il
            vient, d'où vient son nom, et pourquoi nous pensons que les maths servent à quelque chose.
          </p>
        </div>
      </section>

      <section class="apropos-contenu">
        <div class="container">
          <About client:load />
        </div>
      </section>

      <section class="apropos-appel">
        <div class="container">
          <p>Germain s'écrit à plusieurs mains, et il y a de la place pour la vôtre.</p>
          <a class="button bouton-principal" href={`${base}aide`}>Participer au projet</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Un seul rythme vertical pour toute la page : modifiez cette valeur
     pour resserrer ou aérer l'ensemble. */
  main {
    --espace: clamp(2rem, 5vw, 3.5rem);
  }

  .apropos-intro {
    /* le header est fixe : on laisse la place en haut ; pas de marge en bas,
       l'espace avec la section suivante vient d'un seul côté */
    padding: 7rem 0 0;
  }

  .apropos-titre {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1.1;
    color: var(--encre);
    margin: 0 0 1.25rem;
  }

  .apropos-titre span {
    color: var(--violet);
  }

  .apropos-chapeau {
    font-size: 1.2rem;
    line-height: 1.65;
    max-width: 55ch;
    color: #3b3555;
  }

  .apropos-contenu {
    padding: var(--espace) 0;
  }

  .apropos-appel {
    background: var(--papier);
    padding: var(--espace) 0;
  }

  .apropos-appel .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .apropos-appel p {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .button.bouton-principal {
    background: var(--violet);
    border-color: var(--violet);
    color: #fff;
    font-weight: 600;
    border-radius: 999px;
    padding: 1.4rem 1.6rem;
    transition: background-color 0.2s ease;
  }

  .button.bouton-principal:hover {
    background: var(--violet-profond);
    border-color: var(--violet-profond);
    color: #fff;
  }

  @media (max-width: 768px) {
    .apropos-intro {
      padding-top: 6rem;
    }
  }
</style>