---
import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { SITE_TITLE } from '@/consts';
import fs from 'node:fs';
import path from 'node:path';
import '@/styles/bulma.min.css';
import '@/styles/theme.css';
import '@/styles/mobile.css';

const base = '/Germain/';

const pageTitle = 'Exercices';
const pageDescription =
  'Choisissez votre niveau : de la 6ᵉ à l’enseignement supérieur, des exercices toujours différents, corrigés pas à pas.';

/* ------------------------------------------------------------------
   Niveaux proposés.

   - `slug`    : adresse de la liste du niveau → /exercices/<slug>/
                 (fichier src/pages/exercices/<slug>.astro)
   - `dossier` : dossier des composants d'exercices de ce niveau, dans src/exercices/.
                 On y compte automatiquement les fichiers Ex_*.tsx.

   Un niveau sans exercice s'affiche « Bientôt disponible » (non cliquable).
   Pour ouvrir un niveau : ajouter ses exercices dans son dossier, et créer
   sa page src/pages/exercices/<slug>.astro (copie de terminale.astro).
------------------------------------------------------------------ */
type Niveau = { slug: string; court: string; nom: string; resume: string; dossier: string };

const cycles: { id: string; nom: string; niveaux: Niveau[] }[] = [
  {
    id: 'college',
    nom: 'Collège',
    niveaux: [
      { slug: '6eme', court: '6ᵉ', nom: 'Sixième', resume: 'Nombres, fractions, premières figures.', dossier: 'college/6eme' },
      { slug: '5eme', court: '5ᵉ', nom: 'Cinquième', resume: 'Calcul littéral, symétries, proportionnalité.', dossier: 'college/5eme' },
      { slug: '4eme', court: '4ᵉ', nom: 'Quatrième', resume: 'Puissances, Pythagore, équations.', dossier: 'college/4eme' },
      { slug: '3eme', court: '3ᵉ', nom: 'Troisième', resume: 'Fonctions, Thalès, préparation du brevet.', dossier: 'college/3eme' },
    ],
  },
  {
    id: 'lycee',
    nom: 'Lycée',
    niveaux: [
      { slug: 'seconde', court: '2ⁿᵈᵉ', nom: 'Seconde', resume: 'Fonctions, vecteurs, probabilités.', dossier: 'lycee/seconde' },
      { slug: 'premiere', court: '1ʳᵉ', nom: 'Première', resume: 'Dérivation, suites, second degré.', dossier: 'lycee/premiere' },
      { slug: 'terminale', court: 'Tˡᵉ', nom: 'Terminale', resume: 'Limites, intégrales, logarithme, probabilités…', dossier: 'lycee/terminale' },
    ],
  },
  {
    id: 'superieur',
    nom: 'Études supérieures',
    niveaux: [
      { slug: 'superieur', court: 'Sup', nom: 'Supérieur', resume: 'Analyse, algèbre linéaire, probabilités.', dossier: 'superieur' },
    ],
  },
];

// Nombre d'exercices d'un niveau : fichiers Ex_*.tsx de son dossier (lu au moment du build)
const racine = path.join(process.cwd(), 'src/exercices');
const compter = (dossier: string) => {
  const chemin = path.join(racine, dossier);
  if (!fs.existsSync(chemin)) return 0;
  return fs.readdirSync(chemin).filter((f) => /^Ex_.*\.tsx$/.test(f)).length;
};

const groupes = cycles.map((c) => ({
  ...c,
  niveaux: c.niveaux.map((n) => ({ ...n, nombre: compter(n.dossier), href: `${base}exercices/${n.slug}/` })),
}));

const total = groupes.reduce((s, g) => s + g.niveaux.reduce((t, n) => t + n.nombre, 0), 0);
const pluriel = (n: number) => `${n} exercice${n > 1 ? 's' : ''}`;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead title={`${pageTitle} – ${SITE_TITLE}`} description={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- ============ Introduction ============ -->
      <section class="niv-intro">
        <div class="container">
          <h1 class="niv-titre righteous"><span aria-hidden="true">//</span> {pageTitle}</h1>
          <p class="niv-chapeau">
            Choisissez votre niveau. Chaque exercice est tiré au hasard : vous pouvez en refaire autant que vous voulez,
            avec une correction détaillée à chaque fois.
          </p>
          {total > 0 && <p class="niv-total">{pluriel(total)} disponibles</p>}
        </div>
      </section>

      <!-- ============ Niveaux, par cycle ============ -->
      <section class="niv-liste">
        <div class="container">
          {
            groupes.map((g) => (
              <section class="cycle" aria-labelledby={`cycle-${g.id}`}>
                <h2 class="cycle-titre righteous" id={`cycle-${g.id}`}>
                  <span aria-hidden="true">//</span> {g.nom}
                </h2>

                <ul class="niveaux" role="list">
                  {g.niveaux.map((n) => (
                    <li>
                      {n.nombre > 0 ? (
                        <a class="niveau" href={n.href}>
                          <span class="niveau-pastille righteous" aria-hidden="true">{n.court}</span>
                          <span class="niveau-corps">
                            <span class="niveau-nom">{n.nom}</span>
                            <span class="niveau-resume">{n.resume}</span>
                          </span>
                          <span class="niveau-etat">
                            <span class="niveau-nb">{pluriel(n.nombre)}</span>
                            <span class="niveau-fleche" aria-hidden="true">→</span>
                          </span>
                        </a>
                      ) : (
                        <div class="niveau niveau-bientot" aria-disabled="true">
                          <span class="niveau-pastille righteous" aria-hidden="true">{n.court}</span>
                          <span class="niveau-corps">
                            <span class="niveau-nom">{n.nom}</span>
                            <span class="niveau-resume">{n.resume}</span>
                          </span>
                          <span class="niveau-etat">
                            <span class="niveau-nb">Bientôt disponible</span>
                          </span>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>

      <!-- ============ Appel à contribuer ============ -->
      <section class="niv-appel">
        <div class="container">
          <p>Un niveau vous manque ? Germain s'écrit à plusieurs mains.</p>
          <a class="niv-bouton" href={`${base}aide`}>Participer au projet</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* ---------- Introduction ---------- */
  .niv-intro {
    /* le header est fixe : on laisse la place en haut */
    padding: 7rem 0 0;
  }

  .niv-titre {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1.1;
    color: var(--encre, #1f1a3d);
    margin: 0 0 1.25rem;
  }

  .niv-titre span,
  .cycle-titre span {
    color: var(--violet, #6528d9);
  }

  .niv-chapeau {
    max-width: 52ch;
    font-size: 1.15rem;
    line-height: 1.65;
    color: #3b3555;
    margin: 0 0 1rem;
  }

  .niv-total {
    display: inline-block;
    margin: 0;
    padding: 0.25rem 0.9rem;
    border-radius: 999px;
    background: var(--lavande-pale, #efeaff);
    color: var(--violet, #6528d9);
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* ---------- Cycles ---------- */
  .niv-liste {
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .cycle + .cycle {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .cycle-titre {
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    line-height: 1.2;
    color: var(--encre, #1f1a3d);
    margin: 0 0 1.25rem;
  }

  .niveaux {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  /* ---------- Carte d'un niveau ---------- */
  .niveau {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'pastille corps'
      'pastille etat';
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-items: center;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border: 2px solid var(--lavande-pale, #efeaff);
    border-radius: 1.25rem;
    background: #fff;
    color: var(--encre, #1f1a3d);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  a.niveau:hover,
  a.niveau:focus-visible {
    border-color: var(--violet, #6528d9);
    background: var(--papier, #faf9ff);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -14px rgba(101, 40, 217, 0.5);
    color: var(--encre, #1f1a3d);
  }

  .niveau-pastille {
    grid-area: pastille;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--craie, #ffd25e);
    color: var(--violet-profond, #2a1466);
    font-size: 1.3rem;
    line-height: 1;
  }

  .niveau-corps {
    grid-area: corps;
    display: grid;
    gap: 0.15rem;
  }

  .niveau-nom {
    font-family: 'Righteous', sans-serif;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .niveau-resume {
    font-size: 0.95rem;
    line-height: 1.45;
    color: #5b5476;
  }

  .niveau-etat {
    grid-area: etat;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .niveau-nb {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--violet, #6528d9);
  }

  .niveau-fleche {
    font-size: 1.3rem;
    line-height: 1;
    color: var(--violet, #6528d9);
    transition: transform 0.2s ease;
  }

  a.niveau:hover .niveau-fleche,
  a.niveau:focus-visible .niveau-fleche {
    transform: translateX(0.3rem);
  }

  /* Niveau pas encore ouvert */
  .niveau-bientot {
    border-style: dashed;
    background: transparent;
    cursor: default;
  }

  .niveau-bientot .niveau-pastille {
    background: var(--lavande-pale, #efeaff);
    color: var(--lavande, #a28bfa);
  }

  .niveau-bientot .niveau-nom {
    color: #6d6590;
  }

  .niveau-bientot .niveau-nb {
    color: #6d6590;
    font-weight: 500;
  }

  /* ---------- Appel à contribuer ---------- */
  .niv-appel {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    background: var(--violet-profond, #2a1466);
    color: #fff;
    text-align: center;
  }

  .niv-appel p {
    margin: 0 0 1.25rem;
    font-family: 'Righteous', sans-serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }

  .niv-bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    background: #fff;
    color: var(--violet-profond, #2a1466);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .niv-bouton:hover,
  .niv-bouton:focus-visible {
    background: var(--craie, #ffd25e);
    color: var(--violet-profond, #2a1466);
  }

  @media (max-width: 768px) {
    .niv-intro {
      padding-top: 6rem;
    }
    .niv-bouton {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .niveau,
    .niveau-fleche {
      transition: none;
    }
    a.niveau:hover {
      transform: none;
    }
  }
</style>