---
import PageChoixNiveau from '@/components/layout/PageChoixNiveau.astro';
import { cycles, compterExercices } from '@/lib/niveaux';

const base = '/Germain/';

// Pour ouvrir un niveau : ajouter ses exercices dans src/exercices/<dossier>/ et créer src/pages/exercices/<slug>.astro
const groupes = cycles.map((c) => ({
  ...c,
  niveaux: c.niveaux.map((n) => ({ ...n, nombre: compterExercices(n), href: `${base}exercices/${n.slug}/` })),
}));
---

<PageChoixNiveau
  titre="Exercices"
  description="Choisissez votre niveau : de la 6ᵉ à l’enseignement supérieur, des exercices toujours différents, corrigés pas à pas."
  chapeau="Choisissez votre niveau. Chaque exercice est tiré au hasard : vous pouvez en refaire autant que vous voulez, avec une correction détaillée à chaque fois."
  unite="exercice"
  groupes={groupes}
  appel="Un niveau vous manque ? Germain s'écrit à plusieurs mains."
/>