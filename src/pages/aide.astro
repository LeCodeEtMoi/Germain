---
import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import '../styles/bulma.min.css';
import '../styles/theme.css';

const pageTitle = 'Aider le projet Germain';
const pageDescription =
  "Découvrez comment vous pouvez contribuer à l'amélioration et à l'enrichissement du projet Germain.";
const email = 'germainmaths@tutanota.com';
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- ============ Introduction ============ -->
      <section class="aide-intro">
        <div class="container">
          <h1 class="aide-titre righteous"><span aria-hidden="true">//</span> {pageTitle}</h1>
          <p class="aide-chapeau">{pageDescription}</p>
        </div>
      </section>

      <!-- ============ Façons d'aider ============ -->
      <section class="aide-facons">
        <div class="container">
          <h2 class="titre-section righteous"><span aria-hidden="true">//</span> Comment pouvez-vous aider ?</h2>
          <p class="aide-texte">
            Le projet Germain est une initiative ouverte et collaborative. Votre aide est précieuse pour
            le faire grandir et l'améliorer. Voici plusieurs façons de contribuer :
          </p>

          <dl class="facons">
            <div class="facon">
              <dt>Signaler des erreurs</dt>
              <dd>
                Si vous trouvez une coquille, une erreur mathématique ou une explication peu claire,
                n'hésitez pas à nous le faire savoir.
              </dd>
            </div>
            <div class="facon">
              <dt>Suggérer du contenu</dt>
              <dd>Vous avez une idée de leçon ou d'exercice ? Partagez-la avec nous !</dd>
            </div>
            <div class="facon">
              <dt>Améliorer le code</dt>
              <dd>
                Si vous avez des compétences en développement web, vous pouvez proposer des améliorations
                sur notre
                <a href="https://github.com/LeCodeEtMoi/Germain" target="_blank" rel="noopener noreferrer"
                  >dépôt GitHub</a
                >.
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- ============ Éthique + contact ============ -->
      <section class="aide-panneaux">
        <div class="container">
          <div class="panneaux">
            <div class="panneau panneau-ethique">
              <h2 class="titre-panneau righteous"><span aria-hidden="true">//</span> Respect et éthique</h2>
              <p>
                Toute contribution ou suggestion doit impérativement respecter notre
                <a href="/Germain/CodeDéontologie">Code de déontologie</a>. Nous souhaitons maintenir un
                environnement d'apprentissage sain, respectueux et constructif pour tous.
              </p>
            </div>

            <div class="panneau panneau-contact">
              <h2 class="titre-panneau righteous"><span aria-hidden="true">//</span> Prêt à contribuer ?</h2>
              <p>
                Pour toute remarque, suggestion ou signalement, envoyez-nous un message. Nous lisons chaque
                retour avec attention.
              </p>
              <a class="button bouton-clair" href={`mailto:${email}`}>
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="m3 7 9 6 9-6"></path>
                </svg>
                <span>Envoyer un e-mail</span>
              </a>
              <p class="adresse"><a href={`mailto:${email}`}>{email}</a></p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Même rythme vertical que les pages À propos et Code de déontologie */
  main {
    --espace: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---------- Introduction ---------- */
  .aide-intro {
    /* le header est fixe : on laisse la place en haut */
    padding: 7rem 0 0;
  }

  .aide-titre {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1.1;
    color: var(--encre);
    margin: 0 0 1.25rem;
  }

  .aide-titre span,
  .titre-section span,
  .titre-panneau span {
    color: var(--violet);
  }

  .aide-chapeau {
    font-size: 1.2rem;
    line-height: 1.65;
    max-width: 55ch;
    color: #3b3555;
  }

  /* ---------- Façons d'aider ---------- */
  .aide-facons {
    padding: var(--espace) 0 0;
  }

  .titre-section {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.2;
    color: var(--encre);
    margin-bottom: 1.25rem;
  }

  .aide-texte {
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 62ch;
    color: #3b3555;
    margin-bottom: 2rem;
  }

  .facons {
    margin: 0;
    max-width: 52rem;
  }

  .facon {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 0.75rem 2rem;
    padding: 1.5rem 0;
    border-top: 2px solid var(--lavande-pale);
  }

  .facon:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .facon:last-child {
    padding-bottom: 0;
  }

  .facon dt {
    font-family: 'Righteous', sans-serif;
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--encre);
  }

  .facon dd {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 60ch;
    color: #3b3555;
  }

  .facon dd a,
  .panneau-ethique a {
    font-weight: 600;
    color: var(--violet);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .facon dd a:hover,
  .panneau-ethique a:hover {
    color: var(--violet-profond);
  }

  /* ---------- Panneaux éthique et contact ---------- */
  .aide-panneaux {
    padding: var(--espace) 0;
  }

  .panneaux {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .panneau {
    border-radius: 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
  }

  .panneau p {
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .titre-panneau {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .panneau-ethique {
    background: var(--lavande-pale);
    color: var(--encre);
  }

  .panneau-ethique p {
    margin-bottom: 0;
  }

  .panneau-contact {
    background: var(--violet-profond);
    color: #fff;
  }

  .panneau-contact .titre-panneau span {
    color: var(--craie);
  }

  .panneau-contact .adresse {
    margin: 1.25rem 0 0;
    font-size: 1rem;
  }

  .panneau-contact .adresse a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .panneau-contact .adresse a:hover {
    color: var(--craie);
  }

  .button.bouton-clair {
    gap: 0.6rem;
    background: #fff;
    border-color: #fff;
    color: var(--violet-profond);
    font-weight: 600;
    border-radius: 999px;
    padding: 1.4rem 1.6rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .button.bouton-clair:hover {
    background: var(--craie);
    border-color: var(--craie);
    color: var(--violet-profond);
  }

  @media (max-width: 768px) {
    .aide-intro {
      padding-top: 6rem;
    }

    .facon {
      grid-template-columns: 1fr;
    }

    .panneaux {
      grid-template-columns: 1fr;
    }
  }
</style>