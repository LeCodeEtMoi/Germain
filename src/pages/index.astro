---
import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Explication from '@/components/exercice/Explication.tsx';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
// Bulma est importé ici : un <link href="/src/..."> ne fonctionne pas après le build.
import '../styles/bulma.min.css';

const base = '/Germain/';
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- ============ Accroche ============ -->
      <section class="accueil-hero">
        <div class="container">
          <div class="columns is-vcentered">
            <div class="column is-6">
              <h1 class="titre-germain righteous">Germain</h1>
              <p class="accroche">Renforcer vos acquis avec style</p>
              <p class="intro">
                Des leçons, des exercices et des quiz en accès libre, pour aimer les
                mathématiques, que l'on parte de zéro ou que l'on soit déjà à l'aise.
              </p>

              <div class="buttons">
                <a class="button bouton-principal" href={`${base}blog`}>Commencer par une leçon</a>
                <a class="button bouton-secondaire" href={`${base}exercices`}>Faire un exercice</a>
              </div>

              <p class="equation righteous" aria-label="curiosité plus pratique égale progrès">
                curiosité <span aria-hidden="true">+</span> pratique <span aria-hidden="true">=</span> progrès
              </p>
            </div>

            <div class="column is-6">
              <div class="hero-visuel">
                <img
                  src={`${base}Mathematics-amico.svg`}
                  alt="Illustration : une personne entourée de formules de mathématiques"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ Outils ============ -->
      <section class="bloc" id="outils">
        <div class="container">
          <h2 class="titre-section hover-switch">
            <span class="switch-symbol" aria-hidden="true">//</span> Des outils pour renforcer vos acquis
          </h2>
          <Explication client:load />
        </div>
      </section>

      <!-- ============ Mission ============ -->
      <section class="bloc bloc-teinte" id="mission">
        <div class="container">
          <h2 class="titre-section hover-switch">
            <span class="switch-symbol" aria-hidden="true">//</span> Notre mission
          </h2>
          <ul class="mission-liste">
            <li>
              <span class="mission-x righteous" aria-hidden="true">X</span>
              <p>
                Donner au néophyte et à toutes les autres personnes la possibilité d'aimer les mathématiques.
              </p>
            </li>
            <li>
              <span class="mission-x righteous" aria-hidden="true">X</span>
              <p>
                Permettre à quiconque de s'améliorer dans un domaine lié aux mathématiques.
              </p>
            </li>
          </ul>
        </div>
      </section>

      <!-- ============ Open source + aide ============ -->
      <section class="bloc" id="contribuer">
        <div class="container">
          <div class="columns is-variable is-6">
            <div class="column is-5">
              <div class="panneau-opensource">
                <h2 class="titre-section hover-switch">
                  <span class="switch-symbol" aria-hidden="true">//</span> Germain open source
                </h2>
                <p>
                  Germain est un projet open source : tout le monde peut contribuer à son
                  développement. Plus nous avons de retours, plus nous pouvons améliorer Germain et
                  offrir une meilleure immersion dans le pays des maths.
                </p>
                <a
                  class="button bouton-clair"
                  href="https://github.com/LeCodeEtMoi/Germain"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Voir le projet sur GitHub
                </a>
              </div>
            </div>

            <div class="column is-7">
              <div class="coup-de-pouce">
                <h2 class="titre-section hover-switch">
                  <span class="switch-symbol" aria-hidden="true">//</span> Un coup de pouce ?
                </h2>
                <p>Un peu de temps suffit. Vous pouvez par exemple :</p>
                <ul>
                  <li>relire une leçon ou un exercice ;</li>
                  <li>partager votre expérience des maths dans votre métier ;</li>
                  <li>nous faire découvrir un domaine précis qui vous passionne ;</li>
                  <li>proposer une idée de leçon ou d'exercice.</li>
                </ul>
                <p>Toute aide compte pour que le projet grandisse et s'améliore.</p>
                <a class="button bouton-principal" href={`${base}aide`}>Participer au projet</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<!-- Variables partagées avec le composant React (outils.css) et le footer -->
<style is:global>
  :root {
    --violet: #6528d9;
    --violet-profond: #2a1466;
    --lavande: #a28bfa;
    --lavande-pale: #efeaff;
    --papier: #faf9ff;
    --encre: #1f1a3d;
    --craie: #ffd25e;
    --primary-color: var(--violet);
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--encre);
    background: #fff;
  }

  .righteous {
    font-family: 'Righteous', sans-serif;
  }

  :focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 3px;
  }
</style>

<style>
  /* ---------- Accroche ---------- */
  .accueil-hero {
    /* le header est fixe : on laisse la place */
    padding: 7rem 0 4.5rem;
  }

  .titre-germain {
    font-size: clamp(4rem, 11vw, 7.5rem);
    line-height: 1;
    color: var(--violet); /* repli si le dégradé n'est pas supporté */
    background-image: linear-gradient(60deg, var(--lavande), var(--violet));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0 0 0.75rem;
  }

  .accroche {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 48ch;
    color: #3b3555;
    margin-bottom: 2rem;
  }

  .equation {
    margin-top: 2.25rem;
    font-size: 1.35rem;
    color: var(--encre);
  }

  .equation span {
    color: var(--lavande);
    margin: 0 0.25em;
  }

  .hero-visuel {
    background: var(--lavande-pale);
    border-radius: 42% 58% 55% 45% / 50% 45% 55% 50%;
    padding: clamp(1.5rem, 4vw, 3rem);
    max-width: 560px;
    margin-inline: auto;
  }

  .hero-visuel img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Boutons ---------- */
  .button.bouton-principal,
  .button.bouton-secondaire,
  .button.bouton-clair {
    font-weight: 600;
    border-radius: 999px;
    padding: 1.4rem 1.6rem;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .button.bouton-principal {
    background: var(--violet);
    border-color: var(--violet);
    color: #fff;
  }

  .button.bouton-principal:hover {
    background: var(--violet-profond);
    border-color: var(--violet-profond);
    color: #fff;
  }

  .button.bouton-secondaire {
    background: transparent;
    border: 2px solid var(--violet);
    color: var(--violet);
  }

  .button.bouton-secondaire:hover {
    background: var(--lavande-pale);
    color: var(--violet);
  }

  .button.bouton-clair {
    background: #fff;
    border-color: #fff;
    color: var(--violet-profond);
  }

  .button.bouton-clair:hover {
    background: var(--craie);
    border-color: var(--craie);
    color: var(--violet-profond);
  }

  /* ---------- Sections ---------- */
  .bloc {
    padding: 5rem 0;
  }

  .bloc-teinte {
    background: var(--papier);
  }

  .titre-section {
    font-family: 'Righteous', sans-serif;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.2;
    color: var(--encre);
    margin-bottom: 2rem;
  }

  /* Signature du projet : « // » qui devient « \\ » au survol */
  .hover-switch {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  .switch-symbol {
    display: inline-block;
    width: 2ch;
    color: var(--violet);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .hover-switch:hover .switch-symbol {
    opacity: 0;
    transform: scale(0.9) translateY(-0.2em);
  }

  .hover-switch:hover::before {
    content: '\\\\';
    position: absolute;
    left: 0;
    color: var(--violet);
    pointer-events: none;
  }

  /* ---------- Mission ---------- */
  .mission-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
    max-width: 52rem;
  }

  .mission-liste li {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.5;
  }

  .mission-liste p {
    margin: 0;
  }

  .mission-x {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--craie);
    color: var(--violet-profond);
    font-size: 1.6rem;
  }

  /* ---------- Open source / aide ---------- */
  .panneau-opensource {
    background: var(--violet-profond);
    color: #fff;
    border-radius: 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    height: 100%;
  }

  .panneau-opensource .titre-section {
    color: #fff;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .panneau-opensource .switch-symbol,
  .panneau-opensource:hover .hover-switch::before {
    color: var(--craie);
  }

  .panneau-opensource p {
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .coup-de-pouce p,
  .coup-de-pouce li {
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 60ch;
  }

  .coup-de-pouce ul {
    list-style: none;
    margin: 1rem 0 1.5rem;
    padding: 0 0 0 1.25rem;
    border-left: 4px solid var(--lavande);
  }

  .coup-de-pouce li + li {
    margin-top: 0.5rem;
  }

  .coup-de-pouce .button {
    margin-top: 1.25rem;
  }

  @media (max-width: 768px) {
    .accueil-hero {
      padding-top: 6rem;
    }

    .bloc {
      padding: 3.5rem 0;
    }

    .mission-x {
      width: 2.75rem;
      height: 2.75rem;
      font-size: 1.3rem;
    }
  }
</style>