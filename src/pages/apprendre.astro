---
/**
 * Page « Comment apprendre les maths ? »
 * Chaque affirmation renvoie à une référence numérotée (src/data/apprendre.ts, composant <Cite />).
 */
import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cite from '@/components/ui/Cite.astro';
import MethodeCarte from '@/components/ui/MethodeCarte.astro';
import { SITE_TITLE } from '@/consts';
import { REFS, LIBELLE_TYPE } from '@/data/apprendre';
import '@/styles/bulma.min.css';
import '@/styles/theme.css';
import '@/styles/mobile.css';

const base = '/Germain/';
const titre = 'Comment apprendre les maths ?';
const description =
  "Ce que dit la recherche sur les façons les plus efficaces d'apprendre et d'enseigner les mathématiques : méthodes pour les élèves et pour les enseignants, avec les sources.";

const sommaire = [
  { href: '#eleves', texte: 'Pour les élèves' },
  { href: '#enseignants', texte: 'Pour les enseignants' },
  { href: '#synthese', texte: 'En un coup d’œil' },
  { href: '#routine', texte: 'Une routine de 20 min' },
  { href: '#limites', texte: 'Limites' },
  { href: '#references', texte: 'Références' },
];

/* Tableau de synthèse : le texte est volontairement court, le détail est dans les sections. */
const synthese = [
  { methode: "S'auto-tester", preuve: 'Solide', effort: 'Moyen', quand: 'Chaque fois que tu revois un chapitre', lien: '#test' },
  { methode: 'Espacer les révisions', preuve: 'Solide', effort: 'Faible', quand: 'Dès le jour du cours, puis sur plusieurs semaines', lien: '#espacement' },
  { methode: 'Mélanger les exercices', preuve: 'Moyenne', effort: 'Moyen', quand: 'Une fois plusieurs chapitres vus', lien: '#melange' },
  { methode: 'Refaire les exemples', preuve: 'Moyenne', effort: 'Faible', quand: 'Pour un chapitre nouveau', lien: '#exemples' },
  { methode: 'Analyser ses erreurs', preuve: 'Moyenne', effort: 'Faible', quand: 'Après chaque exercice ou contrôle', lien: '#erreurs' },
  { methode: 'Expliquer à voix haute', preuve: 'Moyenne', effort: 'Faible', quand: 'En fin de séance de travail', lien: '#expliquer' },
  { methode: 'Carte mentale', preuve: 'À nuancer', effort: 'Moyen', quand: 'Comme support, jamais seule', lien: '#cartes' },
  { methode: 'Surligner, résumer, relire', preuve: 'Faible', effort: 'Faible', quand: 'À éviter comme méthode principale', lien: '#eviter' },
];
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead title={`${titre} – ${SITE_TITLE}`} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- ============ Introduction ============ -->
      <section class="ap-intro">
        <div class="container">
          <h1 class="ap-titre righteous"><span aria-hidden="true">//</span> {titre}</h1>
          <p class="ap-chapeau">
            Pas de recette miracle : quelques méthodes ont été testées par des chercheurs, sur des milliers d’élèves
            et d’étudiants, et ressortent clairement. Cette page les présente, dit à quel point la preuve est solide,
            et renvoie vers les études pour que tu puisses vérifier toi-même.
          </p>

          <aside class="ap-avertissement" role="note">
            <strong>À savoir.</strong> Le projet Germain ne remplace en rien un cours de mathématiques à l’école. Il
            complète le travail fait en classe, avec un professeur, pour s’entraîner et donner envie d’en faire plus.
          </aside>

          <nav class="ap-sommaire" aria-label="Sommaire de la page">
            <ul role="list">
              {
                sommaire.map((s) => (
                  <li>
                    <a href={s.href}>{s.texte}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </section>

      <!-- ============ Comment lire les niveaux de preuve ============ -->
      <section class="ap-section">
        <div class="container">
          <h2 class="ap-h2 righteous"><span aria-hidden="true">//</span> Comment lire cette page</h2>
          <p class="ap-texte">
            Toutes les idées ne se valent pas. Pour chaque méthode, un badge indique la solidité des preuves. Nous nous appuyons sur les
            grandes synthèses de la recherche en éducation<Cite id={['dunlosky2013', 'pashler2007']} /> ; le classement exact est celui de Germain :
          </p>
          <ul class="ap-legende" role="list">
            <li>
              <span class="badge badge--solide"><span aria-hidden="true">●●●</span> Preuve solide</span>
              Effet observé dans de nombreuses études, dans des contextes variés, y compris en classe.
            </li>
            <li>
              <span class="badge badge--moyenne"><span aria-hidden="true">●●○</span> Preuve moyenne</span>
              Effet observé, mais dans moins d’études ou dans des conditions plus précises.
            </li>
            <li>
              <span class="badge badge--nuancee"><span aria-hidden="true">●○○</span> À nuancer</span>
              Utile sous conditions, ou preuve plus limitée. Nous le disons clairement.
            </li>
          </ul>
        </div>
      </section>

      <!-- ============ ÉLÈVES ============ -->
      <section class="ap-section ap-section--teinte" id="eleves">
        <div class="container">
          <h2 class="ap-h2 righteous"><span aria-hidden="true">//</span> Les méthodes pour les élèves</h2>
          <p class="ap-texte">
            Huit pistes, des mieux établies aux plus nuancées. Aucune n’exige du matériel : un cahier, une feuille et un
            peu de régularité suffisent.
          </p>

          <div class="ap-cartes">
            <MethodeCarte id="test" numero={1} titre="S’auto-tester plutôt que relire" niveau="solide">
              <p>
                Relire sa leçon donne l’impression qu’on la connaît, parce que tout nous paraît familier. Aller
                chercher l’information dans sa mémoire, sans regarder, est bien plus efficace pour la retenir
                durablement. En maths : cache le cours, puis redonne une définition, une formule ou une méthode.
              </p>
              <ol slot="etapes">
                <li>Ferme le cahier.</li>
                <li>Sur une feuille, écris tout ce dont tu te souviens du chapitre : définitions, formules, méthodes.</li>
                <li>Rouvre le cours et corrige, d’une autre couleur, ce qui manquait ou était faux.</li>
                <li>Recommence sur les points ratés le lendemain.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  Dans une expérience classique, relire convient pour un test dans les 5 minutes, mais 2 jours et une
                  semaine plus tard, les élèves qui s’étaient testés retenaient nettement plus que ceux qui avaient
                  relu. Pourtant, les relecteurs se sentaient plus confiants<Cite id="roediger2006" />.
                </li>
                <li>
                  Dans la grande synthèse de Dunlosky et ses collègues, les tests pratiques (« practice testing ») et
                  la pratique espacée sont les deux techniques jugées les plus utiles parmi dix<Cite id="dunlosky2013" />.
                </li>
                <li>
                  Le guide de l’Institute of Education Sciences donne un niveau de preuve « fort » à l’usage de quiz
                  qui obligent à retrouver l’information, à tous les moments de l’apprentissage<Cite id="pashler2007" />.
                </li>
              </ul>
              <Fragment slot="conseil">
                <strong>Conseil Germain :</strong> en maths, teste-toi avec des exercices que tu n’as jamais vus. C’est
                ce que font les <a href={`${base}exercices`}>exercices du site</a> : les valeurs changent à chaque
                « Nouvel exercice ».
              </Fragment>
            </MethodeCarte>

            <MethodeCarte id="espacement" numero={2} titre="Espacer les révisions dans le temps" niveau="solide">
              <p>
                Retenir une leçon, c’est la revoir plusieurs fois, à des intervalles qui s’allongent, plutôt que de tout
                concentrer la veille du contrôle. Entre deux révisions, un peu d’oubli est même utile : le rappel demande
                plus d’effort et ancre mieux le souvenir.
              </p>
              <ol slot="etapes">
                <li>Fais une fiche avec les points clés : formules, méthodes, erreurs à éviter.</li>
                <li>Revois-la, en te testant, à J+1, J+3, J+7 puis J+14 (J = jour du cours).</li>
                <li>Note ces dates dans ton agenda dès le premier jour.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  Une synthèse quantitative de la littérature sur l’espacement conclut qu’étaler les séances
                  améliore la rétention par rapport à une même durée de travail concentrée. Elle porte surtout sur des
                  tâches de rappel verbal<Cite id="cepeda2006" />.
                </li>
                <li>
                  Une grande expérience montre que l’écart idéal entre deux révisions dépend du délai avant l’évaluation
                  : plus l’échéance est lointaine, plus il faut espacer<Cite id="cepeda2008" />.
                </li>
                <li>
                  <strong>Nuance :</strong> J+1, J+3, J+7, J+14 est une règle pratique, pas une loi scientifique. Ce
                  qui compte, c’est d’espacer.
                </li>
                <li>
                  Le guide de l’IES recommande de revoir les contenus essentiels sur des semaines, voire des mois
                  (preuve moyenne)<Cite id="pashler2007" />.
                </li>
              </ul>
            </MethodeCarte>

            <MethodeCarte id="melange" numero={3} titre="Mélanger les types d’exercices" niveau="moyenne">
              <p>
                Faire dix exercices identiques d’affilée est confortable, mais on applique alors la méthode sans se
                demander laquelle choisir. Mélanger des exercices de chapitres différents oblige à reconnaître le type de
                problème avant de calculer. C’est exactement ce qu’on demande à un contrôle.
              </p>
              <ol slot="etapes">
                <li>Après quelques exercices par chapitre, compose une feuille qui mélange dérivées, suites, probabilités…</li>
                <li>Avant de calculer, écris en une ligne : « De quel type de problème s’agit-il ? »</li>
                <li>Ne t’inquiète pas si c’est moins fluide : c’est normal et utile.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  Des élèves qui s’entraînaient sur des problèmes mélangés réussissaient moins bien pendant
                  l’entraînement, mais mieux au test différé que ceux qui s’entraînaient par blocs<Cite id="rohrer2007" />.
                </li>
                <li>
                  Un essai contrôlé randomisé sur 787 élèves de 7ᵉ année (début du collège américain) a comparé des devoirs de
                  maths mélangés à des devoirs par blocs. Le score moyen au test final était d’environ 62 contre 38, et
                  l’étude répond aux standards du What Works Clearinghouse sans réserve<Cite id="rohrer2020" />.
                </li>
                <li>
                  La pratique mélangée figure parmi les techniques d’utilité « moyenne » de la synthèse de Dunlosky<Cite
                    id="dunlosky2013"
                  />.
                </li>
              </ul>
            </MethodeCarte>

            <MethodeCarte id="exemples" numero={4} titre="Refaire les exemples du cours" niveau="moyenne">
              <p>
                Refaire un exemple du cours sans le regarder te dit tout de suite si tu as compris la leçon. Pour les
                débutants, étudier des exemples résolus est même une manière très efficace d’apprendre une méthode, à
                condition de se demander <em>pourquoi</em> chaque étape est faite.
              </p>
              <ol slot="etapes">
                <li>Lis un exemple bien rédigé dans ton cahier.</li>
                <li>
                  À chaque ligne, demande-toi : pourquoi fait-on cette étape ? Qu’est-ce qu’elle permet de trouver ?
                </li>
                <li>Cache l’exemple et refais-le sans regarder.</li>
                <li>Compare avec le corrigé, puis corrige ce qui diffère.</li>
                <li>Quand c’est facile, passe à un exercice similaire sans exemple devant toi.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  En algèbre, des élèves débutants qui étudiaient des exemples résolus apprenaient plus vite et avec
                  moins d’erreurs que ceux qui ne faisaient que résoudre des problèmes<Cite id="sweller1985" />.
                </li>
                <li>
                  Une revue de la recherche sur les exemples résolus insiste sur deux choses : inciter l’élève à
                  s’expliquer chaque étape, et passer progressivement des exemples aux problèmes à résoudre<Cite
                    id="atkinson2000"
                  />.
                </li>
                <li>
                  Les élèves qui s’expliquent à eux-mêmes chaque ligne d’un exemple comprennent mieux que ceux qui le
                  lisent simplement<Cite id="chi1994" />.
                </li>
                <li>
                  Le guide de l’IES recommande d’alterner exemples résolus et problèmes (preuve moyenne), et
                  d’inciter les élèves à répondre à des questions « pourquoi » (preuve forte)<Cite id="pashler2007" />.
                </li>
              </ul>
            </MethodeCarte>

            <MethodeCarte id="erreurs" numero={5} titre="Repérer et analyser ses erreurs" niveau="moyenne">
              <p>
                Faire des exercices encore et encore ne suffit pas si l’on refait toujours la même erreur. Chercher
                <em>pourquoi</em> on s’est trompé, puis le corriger, transforme l’erreur en apprentissage.
              </p>
              <ol slot="etapes">
                <li>Tiens un « cahier d’erreurs » : l’énoncé, ta réponse, la bonne réponse.</li>
                <li>Note la cause : étourderie de calcul, formule oubliée, énoncé mal lu, notion pas comprise.</li>
                <li>Écris en une phrase la règle à retenir.</li>
                <li>Relis le cahier tous les 15 jours et refais un exercice du même type.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  Une revue de la recherche montre que se tromper peut aider à apprendre, à condition de recevoir
                  ensuite une correction<Cite id="metcalfe2017" />.
                </li>
                <li>
                  En algèbre, comparer des exemples corrects <em>et</em> des exemples erronés a aidé des élèves à
                  mieux comprendre qu’avec des exemples corrects seuls<Cite id="booth2013" />.
                </li>
              </ul>
              <Fragment slot="conseil">
                <strong>Dans Germain :</strong> quand ta réponse est fausse, la correction détaillée explique la méthode,
                les erreurs fréquentes et un conseil pour la prochaine fois. Recopie-la dans ton cahier d’erreurs.
              </Fragment>
            </MethodeCarte>

            <MethodeCarte id="expliquer" numero={6} titre="Expliquer une notion à quelqu’un" niveau="moyenne">
              <p>
                Expliquer à voix haute révèle immédiatement ce qu’on n’a pas compris : si tu bloques ou si tu dis
                « enfin, voilà », c’est là qu’il faut retravailler.
              </p>
              <ol slot="etapes">
                <li>Choisis une notion du chapitre.</li>
                <li>Explique-la à un camarade, à un proche ou à un mur, comme à un élève plus jeune.</li>
                <li>Note les endroits où tu hésites, puis retourne au cours pour les compléter.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  L’auto-explication (se justifier à soi-même chaque étape) améliore la compréhension<Cite id="chi1994" />.
                  La synthèse de Dunlosky lui attribue une utilité moyenne<Cite id="dunlosky2013" />.
                </li>
                <li>
                  Le guide de l’IES donne un niveau de preuve fort aux consignes qui amènent l’élève à poser et
                  répondre à des questions d’explication<Cite id="pashler2007" />.
                </li>
                <li>
                  <strong>Nuance :</strong> les preuves les plus nettes concernent l’explication à soi-même. Expliquer à
                  autrui est très pratique pour se tester, mais les études sont moins nombreuses en mathématiques.
                </li>
              </ul>
            </MethodeCarte>

            <MethodeCarte id="cartes" numero={7} titre="Faire des cartes mentales" niveau="nuancee">
              <p>
                Une carte mentale peut aider à voir comment les notions d’un chapitre s’articulent. Mais la dessiner en
                copiant le cours est moins efficace qu’on ne le croit : c’est la <em>récupération</em> en mémoire qui
                fait progresser.
              </p>
              <ol slot="etapes">
                <li>Construis la carte toi-même, avec peu de mots et des liens nommés (« donc », « sert à », « condition »).</li>
                <li>Mets-la de côté, puis redessine-la de mémoire sur une feuille vierge.</li>
                <li>Compare avec la première version et corrige.</li>
              </ol>
              <ul slot="preuves">
                <li>
                  Une méta-analyse trouve que les cartes de concepts sont associées à de meilleurs apprentissages que la
                  lecture de textes ou les listes, surtout quand l’élève les construit lui-même<Cite id="nesbit2006" />.
                </li>
                <li>
                  Mais dans une expérience comparative, s’entraîner à retrouver l’information donnait de meilleurs
                  résultats une semaine plus tard que construire une carte conceptuelle en regardant le texte<Cite
                    id="karpicke2011"
                  />.
                </li>
                <li>
                  <strong>Conclusion :</strong> utilise la carte comme support pour t’auto-tester (méthode 1), pas comme
                  une façon de relire autrement.
                </li>
              </ul>
            </MethodeCarte>

            <MethodeCarte id="eviter" numero={8} titre="Ce qui marche moins bien" niveau="nuancee">
              <p>
                Surligner, faire des résumés et relire plusieurs fois sont les techniques les plus répandues. Ce sont
                aussi parmi les moins efficaces quand elles sont utilisées seules.
              </p>
              <ul slot="preuves">
                <li>
                  La synthèse de Dunlosky classe le résumé, le surlignage et la relecture parmi les techniques d’utilité
                  faible<Cite id="dunlosky2013" />.
                </li>
                <li>
                  La relecture donne un sentiment de confiance plus fort, sans meilleure rétention à long terme<Cite
                    id="roediger2006"
                  />.
                </li>
                <li>
                  <strong>Nuance :</strong> relire reste une bonne première étape pour découvrir un chapitre. Le piège,
                  c’est de s’arrêter là.
                </li>
              </ul>
            </MethodeCarte>
          </div>

          <!-- ---- Bien-être ---- -->
          <h3 class="ap-h3 righteous" id="bien-etre"><span aria-hidden="true">//</span> Et dans la tête ?</h3>
          <div class="ap-trio">
            <article class="ap-mini">
              <h4 class="righteous">Dormir</h4>
              <p>
                Le sommeil participe à la consolidation de la mémoire après l’apprentissage<Cite id="diekelmann2010" />.
                Réviser le soir, puis dormir, vaut mieux que sacrifier sa nuit. (Conclusion pratique de Germain, tirée
                de ce constat général.)
              </p>
            </article>
            <article class="ap-mini">
              <h4 class="righteous">Le stress des contrôles</h4>
              <p>
                Dans des expériences en laboratoire et en classe, écrire ses inquiétudes pendant environ dix minutes
                avant une épreuve a amélioré les résultats des élèves les plus anxieux<Cite id="ramirez2011" />.
              </p>
            </article>
            <article class="ap-mini">
              <h4 class="righteous">« Je ne suis pas une tête en maths »</h4>
              <p>
                Une intervention courte sur l’état d’esprit de progression a eu, dans un grand essai national
                américain, un effet modeste, surtout pour les élèves les plus en difficulté<Cite id="yeager2019" />. Ça
                aide, mais ce n’est pas une baguette magique : le travail reste ce qui compte.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ ENSEIGNANTS ============ -->
      <section class="ap-section" id="enseignants">
        <div class="container">
          <h2 class="ap-h2 righteous"><span aria-hidden="true">//</span> Les méthodes pour les enseignants</h2>
          <p class="ap-texte">
            Côté enseignement, quelques programmes et recommandations s’appuient sur la recherche. Voici ceux que nous
            avons retenus, en commençant par une méthode conçue en France.
          </p>

          <article class="ap-ace" id="ace">
            <header>
              <h3 class="righteous">Méthode ACE – ArithmÉcole</h3>
              <span class="ap-ace-tag">CP et CE1 · France</span>
            </header>
            <p>
              ACE (Arithmétique et Compréhension à l’École élémentaire) est un programme français d’enseignement des
              nombres et du calcul. Il a été conçu par quatre laboratoires de recherche, financé par le Fonds
              d’expérimentation pour la jeunesse puis par le Programme d’investissements d’avenir, et utilisé dans
              environ 300 classes depuis 2012 avec une évaluation quasi-expérimentale<Cite id="ace_lea" />. Ses
              progressions CP et CE1 sont diffusées par l’académie de Lille<Cite id="ace_lille" />.
            </p>
            <p>Ses objectifs principaux :</p>
            <ul>
              <li>
                <strong>Donner du sens aux nombres</strong> en reliant les nombres écrits et les calculs à leur
                représentation sous forme de grandeurs, avec un entraînement régulier à l’estimation tout au long de
                l’année.
              </li>
              <li>
                <strong>Identifier les types de problèmes</strong> et l’équivalence de certaines procédures de calcul pour
                les résoudre.
              </li>
              <li>
                <strong>Consolider les faits arithmétiques</strong> en lien avec les procédures de calcul, grâce à une
                pratique intense et quotidienne du calcul mental.
              </li>
              <li>
                <strong>Expérimenter</strong> différentes représentations numériques et procédures (composition et
                décomposition, groupement par dix…) dans des situations d’apprentissage évolutives.
              </li>
            </ul>
            <p class="ap-ace-note">
              Les résultats chiffrés de l’évaluation sont détaillés dans l’article de la Revue française de
              pédagogie<Cite id="ace_rfp" />. Les ressources pour les enseignants sont
              <a href="https://pedagogie-nord.ac-lille.fr/ace-arithmecole-ressources-pour-lenseignant/" rel="noopener"
                >sur le site de l’académie de Lille</a
              >.
            </p>
          </article>

          <h3 class="ap-h3 righteous"><span aria-hidden="true">//</span> Ce que recommandent les guides internationaux</h3>
          <div class="ap-trio ap-trio--large">
            <article class="ap-mini">
              <h4 class="righteous">Un enseignement explicite</h4>
              <p>
                Présenter en petites étapes, poser beaucoup de questions, guider la pratique, vérifier la compréhension
                et revoir régulièrement : ces principes se retrouvent chez les enseignants les plus efficaces<Cite
                  id="rosenshine2012"
                />. Pour les élèves en difficulté en maths, un enseignement explicite et systématique reçoit un niveau de
                preuve fort<Cite id="gersten2009" />.
              </p>
            </article>
            <article class="ap-mini">
              <h4 class="righteous">Structures de problèmes et schémas</h4>
              <p>
                Apprendre à résoudre les problèmes à partir de leurs structures communes (preuve forte) et utiliser des
                représentations visuelles des idées mathématiques (preuve moyenne)<Cite id="gersten2009" />. Relier le
                concret et l’abstrait est aussi recommandé<Cite id="pashler2007" />.
              </p>
            </article>
            <article class="ap-mini">
              <h4 class="righteous">Automatiser les faits numériques</h4>
              <p>
                Consacrer environ 10 minutes par séance à la récupération rapide des faits arithmétiques de base (preuve
                moyenne)<Cite id="gersten2009" />. C’est proche de l’esprit du calcul mental quotidien d’ACE.
              </p>
            </article>
            <article class="ap-mini">
              <h4 class="righteous">Quiz, espacement, mélange</h4>
              <p>
                Revenir sur les notions clés sur plusieurs semaines, faire des petits quiz de rappel, alterner exemples
                résolus et problèmes<Cite id="pashler2007" />, et mélanger les types d’exercices dans les devoirs<Cite
                  id="rohrer2020"
                />.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ SYNTHÈSE ============ -->
      <section class="ap-section ap-section--teinte" id="synthese">
        <div class="container">
          <h2 class="ap-h2 righteous"><span aria-hidden="true">//</span> En un coup d’œil</h2>
          <div class="ap-tableau" role="region" aria-label="Synthèse des méthodes" tabindex="0">
            <table>
              <thead>
                <tr>
                  <th scope="col">Méthode</th>
                  <th scope="col">Preuve</th>
                  <th scope="col">Effort</th>
                  <th scope="col">Quand l’utiliser</th>
                </tr>
              </thead>
              <tbody>
                {
                  synthese.map((l) => (
                    <tr>
                      <th scope="row">
                        <a href={l.lien}>{l.methode}</a>
                      </th>
                      <td>{l.preuve}</td>
                      <td>{l.effort}</td>
                      <td>{l.quand}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ============ ROUTINE ============ -->
      <section class="ap-section" id="routine">
        <div class="container">
          <h2 class="ap-h2 righteous"><span aria-hidden="true">//</span> Une routine de 20 minutes</h2>
          <p class="ap-texte">
            Proposition de Germain pour combiner les méthodes ci-dessus. C’est un point de départ à adapter : la
            recherche valide chaque technique, pas ce plan précis.
          </p>
          <ol class="ap-routine">
            <li><strong>5 min.</strong> Écris de mémoire ce que tu te rappelles du dernier chapitre, sans regarder.</li>
            <li><strong>3 min.</strong> Corrige avec le cours et note ce qui manquait.</li>
            <li><strong>8 min.</strong> Fais 2 ou 3 exercices mélangeant des chapitres déjà vus.</li>
            <li><strong>4 min.</strong> Note tes erreurs dans le cahier d’erreurs, avec la cause et la règle à retenir.</li>
          </ol>
          <p class="ap-texte">
            Programme ensuite la même routine à J+1, J+3, J+7 et J+14 sur le même chapitre<Cite id="cepeda2008" />.
          </p>
        </div>
