---
import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { SITE_TITLE } from '@/consts';
import { sections } from '@/data/formulaire';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import '@/styles/bulma.min.css';
import '@/styles/theme.css';
import '@/styles/mobile.css';

const base = '/Germain/';

const pageTitle = 'Formulaire';
const pageDescription =
  'Dérivées, primitives, limites, logarithme, trigonométrie, suites, intégrales, probabilités… toutes les formules utiles de mathématiques, réunies sur une seule page.';

/* ------------------------------------------------------------------
   Les formules sont écrites dans src/data/formulaire.ts et rendues par
   KaTeX au moment du build : la page ne charge aucun JavaScript pour
   les afficher.
------------------------------------------------------------------ */
const rendre = (tex: string) => katex.renderToString(tex, { throwOnError: false, output: 'htmlAndMathml' });

// Une cellule qui juxtapose plusieurs formules (séparées par \qquad) est rendue en morceaux :
// sur téléphone, le retour à la ligne se fait entre deux formules, jamais au milieu de l'une d'elles.
const maths = (tex: string) => {
  const morceaux = tex.split('\\qquad').map((m) => m.trim()).filter(Boolean);
  return morceaux.length > 1 ? morceaux.map((m) => `<span class="fo-morceau">${rendre(m)}</span>`).join('') : rendre(tex);
};

const echapper = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Texte avec formules entre $ $  →  HTML
const texte = (s: string) =>
  s
    .split(/\$([^$]*)\$/)
    .map((morceau, i) => (i % 2 ? maths(morceau) : echapper(morceau)))
    .join('');

// Cellule : « ~… » = texte, sinon formule
const cellule = (s: string) => (s === '' ? '' : s.startsWith('~') ? texte(s.slice(1)) : maths(s));

// Texte brut utilisé par la recherche (sans accents, en minuscules)
const normaliser = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase();

const blocs = sections.map((s) => ({
  ...s,
  fiches: s.fiches.map((f) => ({
    ...f,
    large: f.colonnes.length > 3, // beaucoup de colonnes : défile sur téléphone
    // Cellules longues (texte ou formule) : sur téléphone, chaque ligne devient une petite carte (étiquette au-dessus de la valeur)
    empile: f.colonnes.length <= 3 && f.lignes.some((l) => l.some((c) => c.length > (c.startsWith('~') ? 45 : 32))),
    recherche: normaliser([s.titre, f.titre, f.note ?? '', ...f.colonnes, ...f.lignes.flat()].join(' ')),
  })),
}));

const totalFormules = sections.reduce((n, s) => n + s.fiches.reduce((m, f) => m + f.lignes.length, 0), 0);
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead title={`${pageTitle} – ${SITE_TITLE}`} description={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Righteous&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- ============ Introduction ============ -->
      <section class="fo-intro">
        <div class="container">
          <h1 class="fo-titre righteous"><span aria-hidden="true">//</span> {pageTitle}</h1>
          <p class="fo-chapeau">
            Tout ce qu'il faut avoir sous la main : dérivées, primitives, limites, trigonométrie, suites,
            probabilités… Pensé pour la Terminale, utile bien au-delà.
          </p>

          <div class="fo-outils">
            <label class="fo-recherche">
              <span class="fo-sr">Rechercher une formule</span>
              <input
                type="search"
                id="recherche"
                placeholder="Rechercher : « ln », « binomiale », « tangente »…"
                autocomplete="off"
                spellcheck="false"
              />
            </label>
            <button type="button" class="fo-imprimer" id="imprimer">Imprimer</button>
          </div>
          <p class="fo-total">{totalFormules} formules classées en {blocs.length} chapitres</p>
        </div>
      </section>

      <!-- ============ Accès rapide ============ -->
      <section class="fo-nav">
        <div class="container">
          <nav aria-label="Chapitres du formulaire">
            <ul class="fo-liens" role="list">
              {
                blocs.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>{s.titre}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </section>

      <!-- ============ Chapitres ============ -->
      <section class="fo-contenu">
        <div class="container">
          {
            blocs.map((s) => (
              <section class="chapitre" id={s.id} aria-labelledby={`t-${s.id}`}>
                <h2 class="chapitre-titre righteous" id={`t-${s.id}`}>
                  <span aria-hidden="true">//</span> {s.titre}
                </h2>

                <div class="fiches">
                  {s.fiches.map((f) => (
                    <article class={`fiche${f.large ? ' fiche-large' : ''}`} data-recherche={f.recherche}>
                      <h3 class="fiche-titre" set:html={texte(f.titre)} />
                      {f.note && <p class="fiche-note" set:html={texte(f.note)} />}

                      <div class="fiche-defile" role="region" tabindex="0" aria-label={`Tableau : ${f.titre.replace(/\$/g, '')}`}>
                        <table class={`tableau${f.large ? ' tableau-large' : ''}${f.empile ? ' tableau-empile' : ''}`}>
                          <thead>
                            <tr>
                              {f.colonnes.map((c) => (
                                <th scope="col" set:html={texte(c)} />
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {f.lignes.map((ligne) => (
                              <tr>
                                {ligne.map((c, i) => (
                                  <td data-label={f.colonnes[i].replace(/\$[^$]*\$/g, '').trim()} set:html={cellule(c)} />
                                ))}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))
          }

          <p class="fo-vide" id="aucun" hidden>Aucune formule ne correspond à votre recherche.</p>
        </div>
      </section>

      <!-- ============ Appel à contribuer ============ -->
      <section class="fo-appel">
        <div class="container">
          <p>Une formule manque ou une erreur s'est glissée ?</p>
          <a class="fo-bouton" href={`${base}aide`}>Participer au projet</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<script>
  // Recherche : masque les fiches (et les chapitres vides) qui ne contiennent pas les mots saisis.
  const normaliser = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  const champ = document.getElementById('recherche') as HTMLInputElement | null;
  const aucun = document.getElementById('aucun');
  const fiches = [...document.querySelectorAll<HTMLElement>('.fiche')];
  const chapitres = [...document.querySelectorAll<HTMLElement>('.chapitre')];

  function filtrer() {
    const mots = normaliser(champ?.value ?? '')
      .split(/\s+/)
      .filter(Boolean);

    for (const fiche of fiches) {
      const texte = fiche.dataset.recherche ?? '';
      fiche.hidden = !mots.every((m) => texte.includes(m));
    }
    let visibles = 0;
    for (const chapitre of chapitres) {
      const reste = chapitre.querySelectorAll('.fiche:not([hidden])').length;
      chapitre.hidden = reste === 0;
      visibles += reste;
    }
    if (aucun) aucun.hidden = visibles !== 0;
  }

  champ?.addEventListener('input', filtrer);
  document.getElementById('imprimer')?.addEventListener('click', () => window.print());
</script>

<style>
  /* ---------- Introduction ---------- */
  .fo-intro {
    /* le header est fixe : on laisse la place en haut */
    padding: 7rem 0 0;
  }

  .fo-titre {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1.1;
    color: var(--encre, #1f1a3d);
    margin: 0 0 1.25rem;
  }

  .fo-titre span,
  .chapitre-titre span {
    color: var(--violet, #6528d9);
  }

  .fo-chapeau {
    max-width: 54ch;
    font-size: 1.15rem;
    line-height: 1.65;
    color: #3b3555;
    margin: 0 0 1.5rem;
  }

  .fo-outils {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 42rem;
  }

  .fo-recherche {
    flex: 1 1 18rem;
  }

  .fo-recherche input {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 1.2rem;
    border: 2px solid var(--lavande-pale, #efeaff);
    border-radius: 999px;
    background: #fff;
    color: var(--encre, #1f1a3d);
    font: inherit;
    font-size: max(1rem, 16px);
  }

  .fo-recherche input:focus {
    outline: none;
    border-color: var(--violet, #6528d9);
    box-shadow: 0 0 0 3px rgba(101, 40, 217, 0.18);
  }

  .fo-imprimer {
    min-height: 3rem;
    padding: 0.6rem 1.5rem;
    border: 2px solid var(--violet, #6528d9);
    border-radius: 999px;
    background: transparent;
    color: var(--violet, #6528d9);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .fo-imprimer:hover,
  .fo-imprimer:focus-visible {
    background: var(--lavande-pale, #efeaff);
  }

  .fo-total {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    color: #5b5476;
  }

  .fo-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- Accès rapide ---------- */
  .fo-nav {
    padding: 1.5rem 0 0;
  }

  .fo-liens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .fo-liens a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    background: var(--lavande-pale, #efeaff);
    color: var(--violet, #6528d9);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .fo-liens a:hover,
  .fo-liens a:focus-visible {
    background: var(--violet, #6528d9);
    color: #fff;
  }

  /* ---------- Chapitres et fiches ---------- */
  .fo-contenu {
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .chapitre {
    scroll-margin-top: 5rem;
  }

  .chapitre + .chapitre {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .chapitre-titre {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    line-height: 1.2;
    color: var(--encre, #1f1a3d);
    margin: 0 0 1.25rem;
  }

  .fiches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .fiche {
    padding: 1.25rem 1.25rem 1rem;
    border: 2px solid var(--lavande-pale, #efeaff);
    border-radius: 1.25rem;
    background: #fff;
    min-width: 0;
  }

  .fiche-large {
    grid-column: 1 / -1;
  }

  .fiche-titre {
    margin: 0 0 0.35rem;
    font-family: 'Righteous', sans-serif;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--violet, #6528d9);
  }

  .fiche-note {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #5b5476;
  }

  .fiche-defile {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-inline: -0.25rem;
    padding-inline: 0.25rem;
  }

  .fiche-defile:focus-visible {
    outline: 3px solid var(--violet, #6528d9);
    outline-offset: 2px;
    border-radius: 0.5rem;
  }

  /* ---------- Tableaux ---------- */
  .tableau {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .tableau th {
    padding: 0.5rem 0.6rem;
    text-align: left;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #5b5476;
    border-bottom: 2px solid var(--lavande, #a28bfa);
    white-space: nowrap;
  }

  .tableau td {
    padding: 0.55rem 0.6rem;
    vertical-align: middle;
    border-bottom: 1px solid var(--lavande-pale, #efeaff);
  }

  .tableau tbody tr:last-child td {
    border-bottom: 0;
  }

  .tableau tbody tr:hover td {
    background: var(--papier, #faf9ff);
  }

  /* une formule ne se coupe jamais en deux lignes : si elle est trop large, la cellule défile */
  .tableau :global(.katex-html) {
    white-space: nowrap;
  }

  .tableau :global(.fo-morceau) {
    display: inline-block;
    margin-right: 1.5rem;
    padding-block: 0.15rem;
    vertical-align: middle;
  }

  /* première colonne : l'objet dont on parle */
  .tableau td:first-child {
    font-weight: 600;
  }

  .tableau-large th,
  .tableau-large td {
    text-align: center;
  }

  .tableau-large th:first-child,
  .tableau-large td:first-child {
    text-align: left;
  }

  /* ---------- Aucun résultat ---------- */
  .fo-vide {
    margin: 2rem 0 0;
    padding: 1.25rem;
    border: 2px dashed var(--lavande, #a28bfa);
    border-radius: 1.25rem;
    text-align: center;
    color: #5b5476;
  }

  /* ---------- Appel à contribuer ---------- */
  .fo-appel {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    background: var(--violet-profond, #2a1466);
    color: #fff;
    text-align: center;
  }

  .fo-appel p {
    margin: 0 0 1.25rem;
    font-family: 'Righteous', sans-serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }

  .fo-bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    background: #fff;
    color: var(--violet-profond, #2a1466);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .fo-bouton:hover,
  .fo-bouton:focus-visible {
    background: var(--craie, #ffd25e);
    color: var(--violet-profond, #2a1466);
  }

  /* ---------- Téléphone : une ligne de tableau devient une petite carte ---------- */
  @media (max-width: 560px) {
    .fo-intro {
      padding-top: 6rem;
    }

    .fo-imprimer,
    .fo-bouton {
      width: 100%;
    }

    /* Navigation par chapitre : une seule rangée qu'on fait défiler du pouce */
    .fo-liens {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      margin-inline: calc(var(--gouttiere, 1.25rem) * -1);
      padding-inline: var(--gouttiere, 1.25rem);
      scrollbar-width: none;
    }
    .fo-liens::-webkit-scrollbar {
      display: none;
    }
    .fo-liens a {
      white-space: nowrap;
    }

    .fiche {
      padding: 1rem 1rem 0.5rem;
    }

    .tableau th,
    .tableau td {
      padding-inline: 0.4rem;
    }

    .tableau {
      font-size: 0.95rem;
    }

    .tableau.tableau-empile thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .tableau.tableau-empile,
    .tableau.tableau-empile tbody,
    .tableau.tableau-empile tr,
    .tableau.tableau-empile td {
      display: block;
      width: 100%;
    }

    .tableau.tableau-empile tr {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--lavande-pale, #efeaff);
    }

    .tableau.tableau-empile tbody tr:last-child {
      border-bottom: 0;
    }

    .tableau.tableau-empile td {
      padding: 0.2rem 0;
      border: 0;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .tableau.tableau-empile td:empty {
      display: none;
    }

    /* l'en-tête de colonne devient une petite étiquette au-dessus de la valeur */
    .tableau.tableau-empile td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.72rem;
      font-weight: 600;
      color: #6d6590;
    }

    .tableau.tableau-empile td:first-child::before {
      color: var(--lavande, #a28bfa);
    }
  }

  /* ---------- Impression : une feuille de révision ---------- */
  @media print {
    .fo-intro,
    .fo-nav,
    .fo-appel,
    .fo-imprimer,
    .fo-recherche {
      display: none;
    }

    .fo-contenu {
      padding: 0;
    }

    .fiches {
      display: block;
      columns: 2;
      column-gap: 1.25rem;
    }

    .fiche,
    .fiche-large {
      break-inside: avoid;
      margin-bottom: 0.75rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid #999;
      border-radius: 0.5rem;
    }

    .chapitre {
      break-inside: auto;
    }

    .chapitre-titre {
      break-after: avoid;
    }

    .tableau {
      font-size: 0.8rem;
    }
  }
</style>
